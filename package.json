{
  "name": "remote-code-lesson-replay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build",
    "build:site:assets": "vite build --config vite.site.config.ts",
    "build:site": "npm run clean && npm run build:extension && npm run build:site:assets && npm run package && node scripts/finalize-site.mjs",
    "build": "npm run build:site",
    "package": "wxt zip && node scripts/package-extension.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:extension && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/chrome": "0.1.3",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "playwright": "1.58.2",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
